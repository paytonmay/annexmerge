---
const links = [
  { href: '/', label: 'Home' },
  { href: '/the-case/', label: 'Case' },
  { href: '/the-numbers/', label: 'Numbers' },
  { href: '/the-plan/', label: 'Plan' },
  { href: '/precedents/', label: 'Precedents' },
  { href: '/faq/', label: 'FAQ' },
  { href: '/sources/', label: 'Sources' },
  { href: '/supporters/', label: 'Supporters' },
  { href: '/join/', label: 'Join' },
];

const current = Astro.url.pathname.replace(/\/?$/, '/');
---

<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/">One City for the Big Sandy</a>
    <nav class="site-nav" aria-label="Main navigation">
      {links.map(({ href, label }) => (
        <a href={href} aria-current={current === href ? 'page' : undefined}>
          {label}
        </a>
      ))}
    </nav>
  </div>
</header>
