---
// The US-23/US-460 corridor, Pikeville to Prestonsburg, as an animated node
// map. Pure SVG + CSS, no JavaScript. The pulse sweeps outward from Pikeville
// along the spine and the open branches; branch communities render faded.
// Each node carries its own label position to keep text clear of the lines.
const nodes = [
  // Spine: Pikeville to Prestonsburg
  { name: 'Pikeville', x: 165, y: 285, r: 14, city: true, faded: false, lx: 148, ly: 292, anchor: 'end', delay: 0 },
  { name: 'Coal Run Village', x: 235, y: 248, r: 9, city: true, faded: false, lx: 235, ly: 220, anchor: 'middle', delay: 0.55 },
  { name: 'Broad Bottom', x: 300, y: 238, r: 5, city: false, faded: false, lx: 300, ly: 268, anchor: 'middle', delay: 1.1 },
  { name: 'Harold', x: 362, y: 205, r: 5, city: false, faded: false, lx: 362, ly: 180, anchor: 'middle', delay: 1.65 },
  { name: 'Betsy Layne', x: 424, y: 210, r: 5, city: false, faded: false, lx: 424, ly: 242, anchor: 'middle', delay: 2.2 },
  { name: 'Stanville', x: 484, y: 178, r: 5, city: false, faded: false, lx: 484, ly: 152, anchor: 'middle', delay: 2.75 },
  { name: 'Ivel', x: 540, y: 162, r: 5, city: false, faded: false, lx: 540, ly: 192, anchor: 'middle', delay: 3.3 },
  { name: 'Dwale', x: 596, y: 134, r: 5, city: false, faded: false, lx: 596, ly: 108, anchor: 'middle', delay: 3.85 },
  { name: 'Allen', x: 648, y: 118, r: 7, city: true, faded: false, lx: 648, ly: 150, anchor: 'middle', delay: 4.4 },
  { name: 'Prestonsburg', x: 706, y: 72, r: 12, city: true, faded: false, lx: 692, ly: 50, anchor: 'end', delay: 4.95 },
  // Open branch: southeast from Pikeville toward Breaks
  { name: 'Shelbiana', x: 240, y: 330, r: 5, city: false, faded: true, lx: 252, ly: 336, anchor: 'start', delay: 0.55 },
  { name: 'Millard', x: 310, y: 368, r: 5, city: false, faded: true, lx: 322, ly: 372, anchor: 'start', delay: 1.1 },
  { name: 'Elkhorn City', x: 385, y: 400, r: 7, city: true, faded: true, lx: 398, ly: 404, anchor: 'start', delay: 1.65 },
  // Open branch: south from Pikeville on US-23
  { name: 'Robinson Creek', x: 115, y: 340, r: 5, city: false, faded: true, lx: 128, ly: 344, anchor: 'start', delay: 0.55 },
  { name: 'Virgie', x: 70, y: 395, r: 5, city: false, faded: true, lx: 84, ly: 401, anchor: 'start', delay: 1.1 },
  // Open branch: north from Prestonsburg on US-23
  { name: 'Paintsville', x: 768, y: 30, r: 6, city: true, faded: true, lx: 796, ly: 16, anchor: 'end', delay: 5.5 },
];

const spineD = nodes
  .filter((n) => !n.faded)
  .map((n, i) => `${i === 0 ? 'M' : 'L'} ${n.x} ${n.y}`)
  .join(' ');

const branchPaths = [
  'M 165 285 L 240 330 L 310 368 L 385 400',
  'M 165 285 L 115 340 L 70 395',
  'M 706 72 L 768 30',
];
---

<figure class="corridor-map">
  <svg
    viewBox="0 0 800 432"
    role="img"
    aria-labelledby="corridor-map-title corridor-map-desc"
  >
    <title id="corridor-map-title">
      Map of the US-23 corridor from Pikeville to Prestonsburg, with open
      branches in every direction
    </title>
    <desc id="corridor-map-desc">
      Ten communities shown as connected nodes along one valley: Pikeville,
      Coal Run Village, Broad Bottom, Harold, Betsy Layne, Stanville, Ivel,
      Dwale, Allen, and Prestonsburg. Faded nodes mark the open paths in other
      directions: Shelbiana, Millard, and Elkhorn City to the southeast,
      Robinson Creek and Virgie to the south, and Paintsville to the north.
    </desc>

    {branchPaths.map((d) => <path class="branch" d={d} />)}

    <path class="valley" d={spineD} />
    <path class="flow" d={spineD} />

    {nodes.map((n) => (
      <g class={n.faded ? 'node node-faded' : 'node'} style={`--delay: ${n.delay}s`}>
        <circle class="halo" cx={n.x} cy={n.y} r={n.r + 4} />
        <circle
          class={n.city ? 'dot dot-city' : 'dot'}
          cx={n.x}
          cy={n.y}
          r={n.r}
        />
        <text
          class={n.city ? 'label label-city' : 'label'}
          x={n.lx}
          y={n.ly}
          text-anchor={n.anchor}
        >
          {n.name}
        </text>
      </g>
    ))}
  </svg>
  <figcaption>
    One valley, ten communities connected by US-23: Pikeville, Coal Run
    Village, Broad Bottom, Harold, Betsy Layne, Stanville, Ivel, Dwale, Allen,
    and Prestonsburg. Larger nodes are incorporated cities. Faded nodes mark
    the open paths: Shelbiana, Millard, and Elkhorn City toward the southeast,
    Robinson Creek and Virgie to the south, and Paintsville to the north.
  </figcaption>
</figure>

<style>
  .corridor-map {
    margin: 2.5rem 0;
  }

  .corridor-map svg {
    width: 100%;
    height: auto;
    display: block;
  }

  figcaption {
    font-size: 0.88rem;
    color: var(--ink-soft);
    margin-top: 0.5rem;
    max-width: var(--max-prose);
  }

  .branch {
    fill: none;
    stroke: var(--green-600);
    stroke-width: 2;
    stroke-dasharray: 2 7;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.4;
  }

  .valley {
    fill: none;
    stroke: var(--green-100);
    stroke-width: 10;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .flow {
    fill: none;
    stroke: var(--green-600);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 6 18;
    animation: flow 9s linear infinite;
  }

  .dot {
    fill: #fff;
    stroke: var(--green-600);
    stroke-width: 3;
  }

  .dot-city {
    fill: var(--green-800);
    stroke: var(--green-800);
  }

  .node-faded {
    opacity: 0.5;
  }

  .halo {
    fill: none;
    stroke: var(--gold-500);
    stroke-width: 2;
    opacity: 0;
    transform-origin: center;
    transform-box: fill-box;
    animation: pulse 5.5s ease-out infinite;
    animation-delay: var(--delay);
  }

  .label {
    font-size: 15px;
    fill: var(--ink-soft);
  }

  .label-city {
    font-size: 18px;
    font-weight: 700;
    fill: var(--green-900);
  }

  .node-faded .label,
  .node-faded .label-city {
    font-size: 14px;
    font-weight: 400;
  }

  @keyframes pulse {
    0% {
      opacity: 0;
      transform: scale(0.6);
    }
    12% {
      opacity: 0.9;
    }
    35% {
      opacity: 0;
      transform: scale(2.1);
    }
    100% {
      opacity: 0;
      transform: scale(2.1);
    }
  }

  @keyframes flow {
    to {
      stroke-dashoffset: -240;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flow,
    .halo {
      animation: none;
    }
    .halo {
      opacity: 0.35;
      transform: scale(1);
    }
  }
</style>
